# Copy to .env.local and fill real values. See README for details.
# .env.local is loaded by argus_final/core/settings.py (does not override shell env).
# A preconfigured .env.local ships with this submission - no editing is required to run.

# --- Demo vs live CSE ---
ARGUS_DEMO_MODE=true
# When false, backend hits live CSE REST (https://www.cse.lk/api/...)

# --- Narration: local Ollama (Gemma 4) ---
# The narrative and chat layers run local-first through Ollama.
# Priority: ARGUS_OLLAMA_BASE_URL > OLLAMA_BASE_URL > ARGUS_OLLAMA_HOST > OLLAMA_HOST > http://localhost:11434
# Examples (pick one - any key works):
#   OLLAMA_BASE_URL=http://localhost:11434             # Ollama on same machine
#   OLLAMA_BASE_URL=http://host.docker.internal:11434  # Inside Docker, reach host Ollama
#   OLLAMA_BASE_URL=http://<tailscale-ip>:11434        # Desktop Ollama via Tailscale
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
ARGUS_OLLAMA_ENABLED=true
# Timeout for Ollama chat/narrative (seconds).
ARGUS_OLLAMA_TIMEOUT=15
# If Ollama is unreachable, deterministic template narrators keep every
# explanation layer functional - no additional configuration is required.

# --- Optional provider overrides (leave empty to stay fully local) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- CORS ---
ARGUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Redis / Celery (docker-compose stack, optional) ---
REDIS_URL=redis://localhost:6379/0
ARGUS_REDIS_TICKS_ENABLED=false
ARGUS_LLM_QUEUE_ENABLED=false
ARGUS_WS_INGEST_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- ARIMA bounds ---
ARGUS_ARIMA_MODE=auto
ARGUS_ARIMA_MAX_P=5
ARGUS_ARIMA_MAX_Q=5
ARGUS_ARIMA_MAX_D=2
